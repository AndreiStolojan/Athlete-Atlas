rules_version = '2';

// Each team belongs to the user who created it. Only that user can read or
// change the team, its members and its matches. Like the app itself, the
// rules only let in users with a verified email.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function ownsTeam(teamId) {
      return signedIn()
        && get(/databases/$(database)/documents/teams/$(teamId)).data.createdBy == request.auth.uid;
    }

    match /teams/{teamId} {
      allow read, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy;

      match /{subcollection}/{docId} {
        allow read, write: if subcollection in ['members', 'matches'] && ownsTeam(teamId);
      }
    }
  }
}
